{
  "name": "@edms/backend",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "EDMS NestJS backend — HealthModule, JWT-AuthN (Keycloak/jose) + Policy-Interceptor-AuthZ, Audit-Emitter (nestjs-cls Savepoint-Kette), BFF-Auth-Endpoints, Problem+JSON-Fehlerbehandlung (ADR-0001 §10.7, ADR-0002 Teil B).",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "retention": "node dist/retention/retention-main.js",
    "erkennung:tb03": "node dist/einfluss/tb03-erkennung-main.js",
    "nachlauf": "node dist/ingest-worker/nachlauf/nachlauf-main.js",
    "import:messreihe": "node dist/import/import-main.js",
    "demo:daten": "node dist/demo/demo-main.js",
    "start:dev": "tsc --watch --preserveWatchOutput & node --watch dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pg": "^8.13.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "jose": "^6.0.0",
    "mqtt": "^5.15.2",
    "typeorm": "^0.3.20",
    "nestjs-cls": "^6.2.0",
    "@nestjs-cls/transactional": "^3.0.0",
    "@nestjs-cls/transactional-adapter-typeorm": "^1.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8",
    "unplugin-swc": "^1.5.1",
    "@swc/core": "^1.10.7",
    "@nestjs/testing": "^11.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@testcontainers/postgresql": "^10.16.0",
    "testcontainers": "^10.28.0",
    "ajv": "^8.17.1",
    "yaml": "^2.7.0",
    "@edms/migrate": "workspace:*"
  }
}
