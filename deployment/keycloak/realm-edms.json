  "roles": {
    "realm": [
      {
        "name": "betrieb",
        "description": "Internes Betriebs-Team: Stammdaten-CRUD + Monitoring (ADR-0002 Teil A, Persona A). DS-01: disjunkt von compliance-auditor/admin, kein Composite.",
        "composite": false
      },
      {
        "name": "compliance-auditor",
        "description": "Auditor/Compliance: strikt LESEND auf Nachweis-/Audit-Sichten (ADR-0002 Teil A, Persona B). DS-01: NIE Personalunion mit admin, kein Composite.",
        "composite": false
      },
      {
        "name": "admin",
        "description": "Benutzer-/System-Administration (ADR-0002 Teil A). DS-01: ohne Auditor-Rechte in Personalunion, kein Composite.",
        "composite": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "edms-bff",
      "name": "EDMS BFF (NestJS Backend)",
      "description": "Vertraulicher Client, Standard-Flow (Authorization-Code) mit PKCE S256 IdP-seitig erzwungen (ADR-0002 D1/D2/D4, STRIDE-2). Kein Secret in diesem Export (rote Linie 4) - wird durch tools/keycloak/bootstrap-secret.sh via Admin-REST-API gesetzt.",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://localhost:5180/auth/callback",
        "http://127.0.0.1:5180/auth/callback",
        "http://localhost:3000/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5180",
        "http://127.0.0.1:5180"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "actor_typ",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "actor_typ",
            "claim.value": "benutzer",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "edms-worker",
      "name": "EDMS Service-Account-Client (Dienstkonto-Template)",
      "description": "Client-Credentials-Template fuer Dienstkonten (ADR-0002 Persona C). Kein Secret im Export (rote Linie 4). Konkrete Worker klonen dieses Muster (siehe deployment/keycloak/README.md).",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "actor_typ",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "actor_typ",
            "claim.value": "dienstkonto",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
