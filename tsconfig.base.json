// Geteilte TypeScript-Basiskonfiguration (ADR-0001, Abschnitt 10.2).
// Jedes Workspace-Paket erweitert diese Datei und setzt paketspezifisch
// module/moduleResolution/lib/jsx (siehe src/{backend,frontend,shared}/tsconfig.json).
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
