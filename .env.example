# EDMS — Example environment variables (development)
#
# Conventions (see docs/adr/ADR-0001-projekt-skelett.md §10.1/10.7,
# .claude/rules/backend-nestjs.md):
#   - This file NEVER contains real secrets or production values — placeholders only.
#   - Copy to `.env` for local development; `.env` is git-ignored and must never be committed.
#   - Document new variables here BEFORE reading them in application code.
#   - Timestamps are UTC end-to-end (ISO 8601, trailing "Z"); timezone display logic
#     lives exclusively in the frontend.
#   - Format per line: KEY=example_value

NODE_ENV=development

# --- PostgreSQL 16 + TimescaleDB (Apache-2 "-oss" image only, see .claude/rules/dependencies.md) ---
POSTGRES_HOST=localhost
# Praefix der Docker-Volumes (ADR-0011 C3). Default `edms` ergibt die
# bisherigen Namen `edms-postgres-data`/`edms-mosquitto-data` -- bestehende
# Dev-Daten bleiben also, wo sie sind.
#
# NUR aendern, wenn eine ZWEITE Instanz neben der bestehenden laufen soll.
# Ohne eigenen Praefix teilen sich beide Staecke dasselbe Datenverzeichnis,
# auch wenn sie ueber `docker compose -p <name>` getrennt wurden: Compose warnt
# und startet trotzdem, und zwei Postmaster auf einem Datenverzeichnis sind
# genau das, wonach es klingt.
#EDMS_VOLUME_PREFIX=edms

POSTGRES_PORT=5432
POSTGRES_DB=edms
POSTGRES_USER=edms
POSTGRES_PASSWORD=changeme_local_dev_only

# Composed connection string — the single variable read by backend (HealthService)
# and the migration runner. Keep in sync with the granular values above.
DATABASE_URL=postgresql://edms:changeme_local_dev_only@localhost:5432/edms

# --- Backend (NestJS) ---
PORT=3000

# --- Frontend (Vite) — variables must be prefixed VITE_ to be exposed ---
# Empty = same-origin: the Vite dev server proxies /health* to the backend
# (see src/frontend/vite.config.ts), so the backend stays CORS-closed.
# Only set an absolute URL for non-proxied setups (e.g. separate deploys).
VITE_API_BASE_URL=

# --- Keycloak (ADR-0002 Teil B, Phase 4 AP-A — deployment/keycloak/README.md) ---
# Dev-only bootstrap admin for the Keycloak container itself (master realm,
# NOT an edms-realm role). Mapped in docker-compose.dev.yml to the Keycloak-26
# env vars KC_BOOTSTRAP_ADMIN_USERNAME/KC_BOOTSTRAP_ADMIN_PASSWORD (verified
# against the pinned 26.7.0 image; the legacy KEYCLOAK_ADMIN* var names are
# kept here only as the human-facing .env key, not as the Keycloak-internal one).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_local_dev_only
KEYCLOAK_PORT=8080
KEYCLOAK_MANAGEMENT_PORT=9000

# Issuer URL of the `edms` realm (see deployment/keycloak/realm-edms.json).
# This IS the single source of truth for OIDC discovery
# (${KEYCLOAK_ISSUER_URL}/.well-known/openid-configuration).
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/edms

# Dev-only placeholder — NEVER a real secret. The realm export ships the
# `edms-bff` client WITHOUT a secret (Keycloak generates a random one on
# import); tools/keycloak/bootstrap-secret.sh then OVERWRITES it via the
# Admin REST API with the value below, so this variable and the value
# actually configured in Keycloak stay in sync. Rotate by changing this
# value and re-running the bootstrap script (idempotent).
EDMS_BFF_CLIENT_SECRET=changeme_local_dev_only_bff_secret

# --- OIDC (Backend BFF, ADR-0002 Teil B §12 — consumed by a later
# Arbeitspaket, e.g. AP-B "KeycloakOidcAdapter"; names proposed here so the
# Keycloak Fundament and the Backend AP agree on a contract up front) ---
OIDC_CLIENT_ID=edms-bff
# Same-origin dev model: the browser talks to the Vite frontend (5180), which
# proxies /auth/* to this backend (see src/frontend/vite.config.ts). The OIDC
# redirect_uri must therefore be the FRONTEND origin so that after the callback
# the BFF's post-login redirect to "/" resolves to the SPA, not the backend.
# (Live-run finding 2026-07-13: pointing this at :3000 landed the user on the
# backend root -> 404.) The realm export whitelists 5180 (localhost AND
# 127.0.0.1) plus 3000.
#
# Port 5180 statt des Vite-Standards 5173: Der Standard ist der Default JEDES
# Vite-Projekts; auf einer Maschine mit mehreren davon entscheidet die
# Startreihenfolge, wer ihn bekommt — und ein Login von einem anderen Port
# wird von Keycloak abgewiesen. Siehe src/frontend/vite.config.ts.
OIDC_REDIRECT_URI=http://localhost:5180/auth/callback
# CSRF origin allowlist for /auth/refresh + /auth/logout (security-lead review).
AUTH_ALLOWED_ORIGINS=http://localhost:5180

# --- Klimaquelle (ADR-0006 D4/O-B1 — Witterungsbereinigung) ---
# Which KlimaQuellePort adapter gets bound at startup. "synthetic" (default)
# computes a deterministic yearly profile: no network, no foreign data, no
# attribution — the right choice for dev, test and CI. "dwd" fetches real
# daily mean temperatures from the DWD Climate Data Center.
#
# The DWD path is a BULK DOWNLOAD of public files: no parameterised API, and
# the only outbound identifier is the public DWD station number (Auflage A-4,
# docs/datenquellen.md DQ-001). It is NOT a real-PII switch —
# EDMS_SYNTHETIC_ONLY is unaffected and keeps applying to everything else.
#
# With EDMS_KLIMA_QUELLE=dwd the run's stationRef MUST be a DWD station number
# ("01420" or "DWD-01420", s. toDwdStationsId); anything else fails closed.
EDMS_KLIMA_QUELLE=synthetic
# Base URL of the CDC daily-climate directory. Must be https (localhost is the
# only exception, for the integration-test stand-in).
EDMS_DWD_BASIS_URL=https://opendata.dwd.de/climate_environment/CDC/observations_germany/climate/daily/kl
# Per-request timeout and download ceiling for the DWD fetch.
EDMS_DWD_TIMEOUT_MS=30000
EDMS_DWD_MAX_DOWNLOAD_BYTES=33554432

# --- Stammdaten (ADR-0008 Teil B §19/§22 — StammdatenModule, Phase 4) ---
# Synthetic-only self-check truth source (D10). dev|staging|prod; default "dev"
# if unset. Startup fails closed if inconsistent with EDMS_SYNTHETIC_ONLY (s.
# SyntheticOnlyConfigService).
EDMS_ENV_CLASS=dev
# Default "true" if unset. "false" is NOT supported in this codebase yet — no
# production KeyManagementPort is wired, so startup fails closed.
EDMS_SYNTHETIC_ONLY=true
# Fingerprint of the evidence set the ingest-gate release was declared against.
# Only read when EDMS_SYNTHETIC_ONLY=false; the startup check then requires an
# effective release in `gate.ingest_freigabe` (V0083) whose fingerprint matches
# this value, and refuses to start otherwise.
#
# Obtain it from the deploy gate, not by hand:
#   node tools/ci/ingest-gate-status.mjs --fingerabdruck
#
# The point of the match is that a release covers ONE state of the evidence.
# Rework a DPIA or a processor register later and the fingerprint no longer
# matches — the release then has to be declared again instead of silently
# carrying over. The marker itself lives in the OPERATOR's database and holds
# the OPERATOR's evidence: anyone running this software has their own
# processing agreement, their own DPIA, their own hosting.
# EDMS_INGEST_FREIGABE_FINGERABDRUCK=
# Dev-KMS master key (D7/LocalDevKmsAdapter) — 32 raw bytes, Base64-encoded.
# NEVER a real secret / NEVER committed with a real value; dev-only, generate
# locally e.g. via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EDMS_DEV_KMS_MASTER_KEY=changeme_local_dev_only_base64_32_bytes

# --- Blind-Index Pepper (ADR-0005 §26.3, D14/O4 — CryptoModule/LocalDevPepperAdapter) ---
# System-wide secret for the DevEUI blind-index HMAC (O(1) lookup without
# decrypting device.geraet_zuordnung rows). RL-3: >= 32 raw bytes, Hex-encoded,
# NEVER a real secret, NEVER shared across environments (dev/staging/prod use
# DIFFERENT values, SEC-8). Dev-only, generate locally e.g. via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDMS_DEV_BLIND_INDEX_PEPPER=changeme_local_dev_only_hex_32_bytes

# --- Ingest-Worker (ADR-0005 §14-27 — eigenstaendiger Prozess, kein HTTP,
# src/backend/src/ingest-worker/worker-main.ts) ---
# Worker-spezifischer Gate-Marker (§19, D7, TD-6 2x2-Matrix): "synthetic" ist
# in diesem Codestand der EINZIGE unterstuetzte Wert; "real" bricht den
# Bootstrap IMMER fail-closed ab (kein Freigabe-Katalog gebunden).
EDMS_INGEST_BROKER_MODE=synthetic
# Separate, least-privilege DB-Verbindung als Rolle edms_ingest_worker
# (RL-1, V0010) — NIEMALS DATABASE_URL/edms_app fuer den Worker. Passwort NIE
# hier inline eintragen (Secret/Vault-Referenz je Umgebung); lokal per
# LOGIN-Rolle anlegen (s. Auslieferungsbericht ADR-0005 Phase-4 Teil 3,
# Aufgabe F, und der Test-Helper unter ingest-worker/test-support/).
# Die Rolle `edms_ingest_worker_login` wird NICHT von einer Migration angelegt
# (sie braucht ein Passwort, und Passwoerter gehoeren nicht in ein
# veroeffentlichtes Repository). Anlegen mit:
#   EDMS_INGEST_WORKER_PASSWORD=... ./tools/db/dev-ingest-worker-login.sh
# `dev-up.sh` ruft das Skript auf, wenn die Variable gesetzt ist.
EDMS_INGEST_WORKER_PASSWORD=changeme_local_dev_only_ingest_worker
EDMS_INGEST_DATABASE_URL=postgresql://edms_ingest_worker_login@localhost:5432/edms
# Separate, least-privilege DB-Verbindung des TB-03-Erkennungslaufs als Rolle
# edms_einfluss_erkennung (V0079, Auflage A20) — NIEMALS DATABASE_URL. Der Lauf
# liest unbeaufsichtigt Klartext-Personendaten (Personenanzahl, Nutzflaeche);
# ueber die App-Verbindung liefe er mit Loeschrecht auf genau diese Daten.
# Diese Rolle darf lesen und Befunde schreiben, sonst nichts — erzwungen von
# PostgreSQL, nicht vom Anwendungscode. Fehlt die Variable, startet der Lauf
# gar nicht (fail-closed, kein Rueckfall auf DATABASE_URL).
# Login-Rolle anlegen mit:
#   EDMS_EINFLUSS_ERKENNUNG_PASSWORD=... ./tools/db/dev-einfluss-erkennung-login.sh
EDMS_EINFLUSS_ERKENNUNG_PASSWORD=changeme_local_dev_only_einfluss_erkennung
EDMS_EINFLUSS_ERKENNUNG_DATABASE_URL=postgresql://edms_einfluss_erkennung_login@localhost:5432/edms
# MQTT-Broker (ChirpStack-Integration, §14/§17). "mqtt://" ist NUR fuer
# dev/synthetic-only zulaessig — ein produktionsnahes Profil verlangt TLS
# ("mqtts://", SEC-2, s. Deployment-Entwurf im Auslieferungsbericht).
# Kennung DIESES Netzservers (ADR-0011 D8). Nur bei EINER Quelle darf sie
# weggelassen werden (Default: standard). Ab dem zweiten ChirpStack braucht
# JEDER Worker-Prozess eine eigene — zwei Prozesse unter derselben Kennung
# ueberschreiben einander die Statuszeile.
# Erlaubt: a-z, 0-9, _ und - (erstes Zeichen alphanumerisch).
#EDMS_INGEST_QUELLE_CODE=standard

EDMS_INGEST_MQTT_URL=mqtt://localhost:1883

# Adressen des Ingest-Workers, WENN er als Compose-Dienst laeuft
# (`--profile ingest`, ADR-0011 C3). Im Container ist `localhost` der
# Container selbst -- er muss die Dienstnamen des Compose-Netzes verwenden.
# Die beiden Zeilen darueber/darunter gelten weiterhin fuer den Worker als
# lokalen `node`-Prozess; beide Betriebsarten stehen bewusst nebeneinander.
#EDMS_INGEST_DATABASE_URL_CONTAINER=postgresql://edms_ingest_worker_login:DevOnlyIngestWorker2026@postgres:5432/edms
#EDMS_INGEST_MQTT_URL_CONTAINER=mqtt://mosquitto:1883
EDMS_INGEST_MQTT_CLIENT_ID=edms-ingest-worker

# Uplink-Topic des Netzservers. Weglassen fuer das ChirpStack-v4-Standard-Template
# (application/{{application_id}}/device/{{dev_eui}}/event/{{event}}, auf Uplink
# eingeschraenkt). Nur setzen, wenn die Instanz ein abweichendes Template fuehrt.
# ACHTUNG: Passt das Topic nicht, kommt STILLSCHWEIGEND nichts an — das Abo laeuft
# ins Leere, ohne Fehler (ADR-0011 C1). Leer gesetzt = Startfehler, kein Default.
#EDMS_INGEST_MQTT_TOPIC=application/+/device/+/event/up
# Nur synthetic-only-Dev-Fallback (§17) — im produktiven Pfad ist mTLS
# vorgesehen, KEIN Username/Passwort. Leer lassen, wenn der Dev-Broker
# anonyme Verbindungen erlaubt.
EDMS_INGEST_MQTT_USERNAME=
EDMS_INGEST_MQTT_PASSWORD=

# --- Synthetischer Uplink-Publisher (ADR-0005 §16, D4 — Dev-Betrieb/E2E-Test,
# src/backend/src/ingest-worker/synthetic-publisher/publisher-main.ts) ---
# Teilt sich per Default EDMS_INGEST_MQTT_URL; eigener Broker-Account (§17,
# separate ACL: nur Publish) ueberschreibt bei Bedarf hier:
EDMS_SYNTHETIC_PUBLISHER_MQTT_URL=
EDMS_SYNTHETIC_PUBLISHER_MQTT_CLIENT_ID=edms-synthetic-publisher
EDMS_SYNTHETIC_PUBLISHER_MQTT_USERNAME=
EDMS_SYNTHETIC_PUBLISHER_MQTT_PASSWORD=
# DevEUI eines bereits provisionierten Test-Geraets (device.geraet_zuordnung) —
# NUR ein offensichtlich synthetischer Platzhalterwert, z. B. AA-AA-AA-AA-AA-AA-AA-01.
EDMS_SYNTHETIC_PUBLISHER_DEVEUI=
# Publish-Intervall in ms — Default 900000 (15 min, DSFA-0001 §1 Beispiel-Kadenz).
EDMS_SYNTHETIC_PUBLISHER_INTERVALL_MS=900000
# Zaehlerstand, ab dem der Simulator hochzaehlt. Default 0 — richtig fuer einen
# frischen Kanal, FALSCH fuer jeden, der schon Werte hat: Ein kumulativer
# Zaehlerstand darf nie zurueckspringen, die Monotonie-Pruefung der Aufnahme
# weist ihn sonst ab (und der Publisher begann frueher bei jedem Neustart wieder
# bei 1). Haengt der Simulator an einem bestehenden Kanal, gehoert hier dessen
# erreichter Stand hinein.
EDMS_SYNTHETIC_PUBLISHER_STARTWERT=

# --- Nutzerportal (ADR-0012, [Q3] Kap. 6) ---
# Die Adresse, die im gedruckten Zugangsbrief steht. Sie ist der einzige Weg,
# auf dem der Endkunde das Portal findet -- ein falscher Wert ist gedruckt,
# verschickt und nicht mehr korrigierbar. Nicht gesetzt = Dev-Adresse
# (http://localhost:5180/portal); die Ausgabe-Antwort meldet das dem Betrieb.
# Muss https sein (Ausnahme: localhost): Die Sitzung haengt an einem
# `__Host-`-Cookie, und das gibt es ohne `Secure` nicht.
#EDMS_PORTAL_URL=https://portal.example.org
